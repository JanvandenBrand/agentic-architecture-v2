{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aramsmith/agentic-architecture-v2/schemas/aff/1.1.0/claim-catalogue.schema.json",
  "title": "AFF claim catalogue 1.1.0",
  "type": "object",
  "required": ["schemaVersion", "recordType", "caseName", "artifactPrefix", "claims"],
  "properties": {
    "schemaVersion": { "$ref": "shared.schema.json#/$defs/schemaVersion" },
    "recordType": { "const": "claim-catalogue" },
    "caseName": { "$ref": "shared.schema.json#/$defs/caseName" },
    "artifactPrefix": { "$ref": "shared.schema.json#/$defs/artifactPrefix" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "evidenceType", "source", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "evidenceType": {
            "enum": ["SOURCE-FACT", "HUMAN-HYPOTHESIS", "DESIGN-INTENT", "STATICALLY-VALIDATED", "UNTESTED-RUNTIME"]
          },
          "source": { "$ref": "shared.schema.json#/$defs/artifactBinding" },
          "status": { "enum": ["SUPPORTED", "QUALIFIED", "REMOVED"] }
        },
        "additionalProperties": false
      }
    },
    "extensions": { "$ref": "shared.schema.json#/$defs/extensions" }
  },
  "additionalProperties": false
}
