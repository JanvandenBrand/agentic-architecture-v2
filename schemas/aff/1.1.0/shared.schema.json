{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aramsmith/agentic-architecture-v2/schemas/aff/1.1.0/shared.schema.json",
  "title": "AFF shared contract definitions 1.1.0",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "const": "1.1.0"
    },
    "host": {
      "type": "string",
      "enum": ["github-copilot", "claude-code"]
    },
    "caseName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "artifactPrefix": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "phaseId": {
      "type": "string",
      "enum": ["0", "1", "2", "3", "4", "5", "6", "7", "8"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "casePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
    },
    "artifactBinding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "$ref": "#/$defs/casePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "evidenceReference": {
      "type": "object",
      "required": ["source", "summary"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "summary", "evidence", "owner", "status"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": ["BLOCKER", "MAJOR", "MINOR"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceReference"
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["OPEN", "ACCEPTED", "RESOLVED", "REJECTED", "RESIDUAL"]
        },
        "requiredAction": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
