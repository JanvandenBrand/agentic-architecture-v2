{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aramsmith/agentic-architecture-v2/schemas/aff/1.1.0/azure-design-catalogue.schema.json",
  "title": "AFF Azure design catalogue 1.1.0",
  "type": "object",
  "required": ["schemaVersion", "recordType", "caseName", "artifactPrefix", "revision", "architectureRevision", "components", "controls", "wafAssessments", "environments"],
  "properties": {
    "schemaVersion": { "$ref": "shared.schema.json#/$defs/schemaVersion" },
    "recordType": { "const": "azure-design-catalogue" },
    "caseName": { "$ref": "shared.schema.json#/$defs/caseName" },
    "artifactPrefix": { "$ref": "shared.schema.json#/$defs/artifactPrefix" },
    "revision": { "type": "string", "minLength": 1 },
    "architectureRevision": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "buildingBlocks", "requirements", "azureServices"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "buildingBlocks": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "requirements": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "azureServices": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "region": { "type": "string" },
          "sku": { "type": "string" },
          "networking": { "type": "string" },
          "identity": { "type": "string" },
          "resilience": { "type": "string" },
          "observability": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "controls": { "type": "array", "items": { "$ref": "#/$defs/trace" } },
    "wafAssessments": { "type": "array", "items": { "$ref": "#/$defs/trace" } },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "parameters"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "parameters": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      }
    },
    "extensions": { "$ref": "shared.schema.json#/$defs/extensions" }
  },
  "$defs": {
    "trace": {
      "type": "object",
      "required": ["id", "summary", "requirements", "designElements"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "requirements": { "type": "array", "items": { "type": "string" } },
        "designElements": { "type": "array", "items": { "type": "string" } },
        "tradeOff": { "type": "string" },
        "evidence": { "type": "array", "items": { "$ref": "shared.schema.json#/$defs/evidenceReference" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
